# ---------------------------------------------------------------------------
# Clinical Snapshot — environment template
#
# Copy to .env only if you need to override a default:
#
#     cp .env.example .env
#
# The application runs with NO environment variables set. Every value below is
# optional. Never put a real credential in this file — it is tracked in git.
# ---------------------------------------------------------------------------

# Not used by the application at runtime.
#
# The application makes no outbound network calls and no LLM calls: `anthropic`
# is not a dependency and is imported nowhere. This variable exists because the
# assignment supplies an API key for the AI *coding assistant* used to build the
# project. See AI_USAGE.md. Keep the real key in .env, which is gitignored.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Backend (read by apps/api/src/clinical_snapshot/config.py) -------------

# Which FHIR bundle to serve. Defaults to data/scenario1_fhir_bundle.json.
# CLINICAL_SNAPSHOT_BUNDLE_PATH=data/scenario1_fhir_bundle.json

# Whether the numeric value of a retracted Observation is withheld from the
# excluded collection. Defaults to true — see README, "Clinical safety".
# CLINICAL_SNAPSHOT_WITHHOLD_EXCLUDED_OBSERVATION_VALUES=true

# Log level for the structured JSON logger. Defaults to INFO.
# CLINICAL_SNAPSHOT_LOG_LEVEL=INFO

# Browser origins permitted by CORS. Defaults to the local frontend only.
# CLINICAL_SNAPSHOT_CORS_ORIGINS=["http://localhost:3000"]

# --- Frontend (read by apps/web/lib/api.ts) --------------------------------

# Where the frontend's server components reach the API.
# Defaults to http://localhost:8000; docker-compose sets http://api:8000.
# API_BASE_URL=http://localhost:8000
